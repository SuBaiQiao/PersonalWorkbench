@page "/tools/cron-generator"
@{
    ViewData["Title"] = "Cron 表达式生成器";
}

<section class="page-intro" aria-labelledby="cron-title">
    <p class="eyebrow">SCHEDULE UTILITY / CRON</p>
    <h1 id="cron-title">Cron 表达式生成器</h1>
    <p class="intro-copy">选择常见的执行频率和时间参数，生成可用于 Linux、容器和定时任务系统的标准五字段 Cron 表达式。</p>
</section>

<section class="panel converter-panel cron-panel" aria-labelledby="cron-form-title">
    <div class="panel-heading">
        <div>
            <p class="panel-kicker">BUILD EXPRESSION</p>
            <h2 id="cron-form-title">定时规则</h2>
        </div>
        <span class="panel-index">05</span>
    </div>

    <form id="cronForm" class="converter-form">
        <div class="cron-form-grid">
            <label class="field">
                <span>执行频率</span>
                <select id="cronFrequency">
                    <option value="minutely">每隔几分钟</option>
                    <option value="hourly">每隔几小时</option>
                    <option value="daily" selected>每天</option>
                    <option value="weekly">每周</option>
                    <option value="monthly">每月</option>
                </select>
            </label>

            <label id="cronIntervalField" class="field">
                <span>执行间隔</span>
                <input id="cronInterval" type="number" min="1" max="59" value="5" />
                <small id="cronIntervalHint">分钟，范围 1-59</small>
            </label>

            <label id="cronHourField" class="field">
                <span>小时</span>
                <input id="cronHour" type="number" min="0" max="23" value="9" />
                <small>24 小时制，范围 0-23</small>
            </label>

            <label id="cronMinuteField" class="field">
                <span>分钟</span>
                <input id="cronMinute" type="number" min="0" max="59" value="0" />
                <small>范围 0-59</small>
            </label>

            <label id="cronWeekdayField" class="field">
                <span>星期</span>
                <select id="cronWeekday">
                    <option value="1">星期一</option>
                    <option value="2">星期二</option>
                    <option value="3">星期三</option>
                    <option value="4">星期四</option>
                    <option value="5">星期五</option>
                    <option value="6">星期六</option>
                    <option value="0">星期日</option>
                </select>
                <small>Cron 中星期日使用 0</small>
            </label>

            <label id="cronDayOfMonthField" class="field">
                <span>每月第几日</span>
                <input id="cronDayOfMonth" type="number" min="1" max="31" value="1" />
                <small>范围 1-31</small>
            </label>
        </div>

        <div class="form-actions converter-actions">
            <button id="generateCronButton" class="button button-primary" type="submit">生成表达式</button>
            <button id="clearCronButton" class="button button-quiet" type="button">恢复默认</button>
            <output id="cronStatus" class="status" role="status" aria-live="polite"></output>
        </div>

        <div class="cron-result" aria-live="polite">
            <div class="cron-result-heading">
                <span class="panel-kicker">RESULT</span>
                <button id="copyCronButton" class="button button-secondary" type="button" disabled>复制表达式</button>
            </div>
            <code id="cronExpression" class="cron-expression">尚未生成</code>
            <p id="cronDescription" class="cron-description">生成后会显示规则说明。</p>
        </div>

        <div class="output-footer">
            <span>API · <code>POST /api/cron/generate</code></span>
            <span>格式 · 分钟 小时 日期 月份 星期</span>
        </div>
    </form>
</section>

<section class="cron-note" aria-label="Cron 格式说明">
    <p><strong>字段顺序：</strong><code>分钟 小时 日期 月份 星期</code>。本工具生成的是标准五字段表达式，不包含 Quartz 的秒字段。</p>
</section>

@section Scripts {
    <script src="~/js/cron-generator.js" asp-append-version="true"></script>
}
